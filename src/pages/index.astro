---
import SiteLayout from '../layouts/SiteLayout.astro';
import WpHtmlPage from '../components/WpHtmlPage.astro';
import { routeForPath } from '../data/routes';

const route = routeForPath('/');

if (!route) {
  throw new Error('Missing root route');
}
---

<SiteLayout route={route}>
  <WpHtmlPage route={route} />
</SiteLayout>
