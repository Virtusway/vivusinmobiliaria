---
import SiteLayout from '../layouts/SiteLayout.astro';
import WpHtmlPage from '../components/WpHtmlPage.astro';
import type { MigratedRoute } from '../data/routes';

const route: MigratedRoute = {
  locale: 'es',
  path: '/404/',
  sourceUrl: '',
  title: 'Página no encontrada - Vivus',
  description: 'Página no encontrada.',
  canonicalPath: '/404/',
  alternates: { es: '/404/' },
  bodyClass: '',
  contentFile: '404.html',
  group: '404',
};
---

<SiteLayout route={route}>
  <WpHtmlPage route={route} />
</SiteLayout>
